# Copy this file to ".env" for local development.
# On Cloudflare Pages add the same two variables under Settings > Environment variables.
#
# Both values are in Supabase > Project Settings > API.
# The anon / publishable key is designed to be public; your data is protected by Row Level Security.
# NEVER put the "service_role" / secret key here or anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
